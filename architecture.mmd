flowchart TD
    %% Styling
    classDef client fill:#1e1b4b,stroke:#6366f1,stroke-width:2px,color:#e0e7ff;
    classDef gateway fill:#0f172a,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef agent fill:#090d16,stroke:#818cf8,stroke-width:2px,color:#ffffff;
    classDef tool fill:#064e3b,stroke:#34d399,stroke-width:1.5px,color:#ecfdf5;
    classDef checkpointer fill:#312e81,stroke:#a855f7,stroke-width:2px,color:#f3e8ff;
    classDef hitl fill:#78350f,stroke:#f59e0b,stroke-width:2px,color:#fef3c7;
    classDef regulator fill:#581c87,stroke:#c084fc,stroke-width:2px,color:#f3e8ff;
    classDef term fill:#065f46,stroke:#10b981,stroke-width:2px,color:#d1fae5;

    Client["React 18 Dashboard<br/>(Vite Console)"]:::client
    API["FastAPI Ingestion Gateway<br/>/api/v1/investigations"]:::gateway
    CaseStore[("PostgreSQL 16<br/>Ledger, Cases & Audit State")]:::checkpointer
    Checkpointer[("LangGraph PostgreSQL<br/>Durable Checkpoints")]:::checkpointer

    subgraph Governance ["Three-Party Decision Governance"]
        Maker["AML Analyst<br/>Maker Recommendation"]:::hitl
        Checker["Independent MLRO<br/>Binding Decision / FIU Referral"]:::gateway
        FIU["FIU-IND Officer<br/>External Disposition"]:::regulator
        RegulatoryTerminal["Immutable Regulator Outcome<br/>Cleared / Monitoring / Enforcement"]:::term
    end

    subgraph LangGraph_Machine ["LangGraph Stateful Orchestration"]
        InvNode["Node 1: Transaction Investigator"]:::agent
        AnalystNode["Node 2: Customer Risk Analyst"]:::agent
        RAGNode["Node 3: Regulatory Researcher"]:::agent
        EvalNode["Node 4: Compliance Evaluator<br/>(Reducer: operator.add)"]:::agent
        HITLNode["Node 5: Human Approval Node<br/>interrupt() Boundary"]:::hitl
        TermNode["Terminal State<br/>(AUTO_APPROVED / CLEARED)"]:::term
    end

    subgraph Data_Layer ["Data & Tool Subsystems"]
        LedgerTool["PostgreSQL Core Ledger<br/>Indexed Transaction Lookup"]:::tool
        AccountDirectory["Canonical Account-Holder Directory<br/>Search / Pagination / Sampling"]:::tool
        ProfilerTool["Turnover Velocity Profiler<br/>& Sanctions Watchlist"]:::tool
        RAGRetriever["Hybrid BM25 + pgvector HNSW<br/>Reciprocal Rank Fusion (k=60)"]:::tool
    end

    Client -->|"1. POST /simulate or /run"| API
    API <-->|"2. Durable business state"| CaseStore
    API -->|"3. Initialize thread_id"| Checkpointer
    Checkpointer -->|"4. Invoke StateGraph"| InvNode

    InvNode <-->|"Ledger Query"| LedgerTool
    LedgerTool -->|"Latest identity projection"| AccountDirectory
    Client <-->|"Search / select one bound identity"| AccountDirectory
    InvNode -->|"State Dispatch"| AnalystNode
    InvNode -->|"State Dispatch"| RAGNode

    AnalystNode <-->|"Velocity Check"| ProfilerTool
    RAGNode <-->|"Fused Semantic Search"| RAGRetriever

    AnalystNode -->|"Findings Delta"| EvalNode
    RAGNode -->|"Findings Delta"| EvalNode

    EvalNode -->|"Risk >= 0.70 Threshold"| HITLNode
    EvalNode -->|"Risk < 0.70 Safe"| TermNode

    HITLNode -->|"5. Pause graph execution"| Checkpointer
    Client <-->|"6. Submit evidence"| Maker
    Maker -->|"Atomic PENDING_MAKER → PENDING_CHECKER"| Checker
    Checker -->|"Approve / Reject"| TermNode
    Checker -->|"Escalate + unique FIU docket"| FIU
    FIU -->|"Atomic one-time disposition"| RegulatoryTerminal
    Maker -->|"Persist recommendation"| CaseStore
    Checker -->|"Persist binding decision"| CaseStore
    FIU -->|"Persist external outcome"| CaseStore
    Maker -. "Cannot self-adjudicate" .-> Checker
    Checker -. "Cannot self-resolve escalation" .-> FIU
    HITLNode --> Maker
