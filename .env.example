OPENAI_API_KEY=your-openai-api-key-here
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/finsight
DATABASE_CHECKPOINT_URL=postgresql://postgres:password@localhost:5432/finsight
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=10
CHECKPOINT_POOL_STARTUP_TIMEOUT=30
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/finsight_test
LANGCHAIN_TRACING_V2=false
APP_ENV=development
DEMO_MODE=true
VITE_DEMO_MODE=true
COOKIE_SECURE=false
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
MLRO_SHARMA_PASSWORD=replace-in-production
MLRO_SHARMA_TOTP_SEED=replace-with-base32-secret
MLRO_KAPOOR_PASSWORD=replace-in-production
MLRO_KAPOOR_TOTP_SEED=replace-with-base32-secret
ANALYST_VERMA_PASSWORD=replace-in-production
ANALYST_VERMA_TOTP_SEED=replace-with-base32-secret
REGULATOR_IYER_PASSWORD=replace-in-production
REGULATOR_IYER_TOTP_SEED=replace-with-base32-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional, for controlled preview subdomains only:
# ALLOWED_ORIGIN_REGEX=https://preview-[a-z0-9-]+\.example\.com
